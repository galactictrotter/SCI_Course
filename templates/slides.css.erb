@font-face {
  font-family: "Barlow Condensed";
  src: url("assets/fonts/barlow-condensed-400.ttf") format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: block;
}

@font-face {
  font-family: "Barlow Condensed";
  src: url("assets/fonts/barlow-condensed-600.ttf") format("truetype");
  font-weight: 600;
  font-style: normal;
  font-display: block;
}

@font-face {
  font-family: "EB Garamond";
  src: url("assets/fonts/eb-garamond-600.ttf") format("truetype");
  font-weight: 600;
  font-style: normal;
  font-display: block;
}

@font-face {
  font-family: "EB Garamond";
  src: url("assets/fonts/eb-garamond-700.ttf") format("truetype");
  font-weight: 700;
  font-style: normal;
  font-display: block;
}

@font-face {
  font-family: "Lora";
  src: url("assets/fonts/lora-400.ttf") format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: block;
}

@font-face {
  font-family: "Lora";
  src: url("assets/fonts/lora-600.ttf") format("truetype");
  font-weight: 600;
  font-style: normal;
  font-display: block;
}

:root {
  --canvas-width: <%= canvas_width %>px;
  --canvas-height: <%= canvas_height %>px;
  --background: <%= colors.fetch("background") %>;
  --text: <%= colors.fetch("text") %>;
  --red: <%= colors.fetch("red") %>;
  --muted: <%= colors.fetch("muted") %>;
  --stage: <%= colors.fetch("stage") %>;
  --margin-x: <%= layout.fetch("margin_x") %>px;
}

* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: var(--stage);
  color: var(--text);
}

body {
  font-family: "Lora", serif;
}

.deck-stage {
  position: absolute;
  left: 50%;
  top: 50%;
  width: var(--canvas-width);
  height: var(--canvas-height);
  transform-origin: center center;
  background: var(--background);
  box-shadow: 0 22px 70px rgba(0, 0, 0, 0.28);
}

.slide {
  position: absolute;
  inset: 0;
  display: none;
  width: var(--canvas-width);
  height: var(--canvas-height);
  padding: 0 var(--margin-x);
  overflow: hidden;
  background: var(--background);
}

.slide.is-active {
  display: block;
}

.slide-header {
  position: absolute;
  top: <%= layout.fetch("header_y") %>px;
  left: var(--margin-x);
  right: var(--margin-x);
  height: 44px;
  font-family: "Barlow Condensed", sans-serif;
  font-size: <%= type.fetch("section_header") %>px;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.02em;
  color: var(--red);
}

.lesson-title {
  position: absolute;
  top: <%= layout.fetch("content_y") %>px;
  left: var(--margin-x);
  right: var(--margin-x);
  margin: 0;
  font-family: "EB Garamond", serif;
  font-size: <%= type.fetch("lesson_title") %>px;
  font-weight: 600;
  line-height: 1.04;
  color: var(--text);
  height: 86px;
  overflow: hidden;
  white-space: normal;
}

.lesson-title--long {
  font-size: 39px;
  line-height: 1;
}

.slide-content {
  position: absolute;
  top: 242px;
  left: var(--margin-x);
  right: var(--margin-x);
  height: <%= layout.fetch("content_height") %>px;
  overflow: hidden;
  font-family: "Lora", serif;
  font-size: <%= type.fetch("body") %>px;
  font-weight: 400;
  line-height: 1.34;
}

.slide-content.reading-content {
  font-size: <%= content_pagination.fetch("font_size") %>px;
  line-height: 1.35;
  height: <%= layout.fetch("reading_height") %>px;
}

.numbered-item {
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr);
  gap: 14px;
  margin: 0 0 32px;
}

.numbered-item:last-child {
  margin-bottom: 0;
}

.item-number {
  font-family: "Barlow Condensed", sans-serif;
  font-size: 32px;
  font-weight: 600;
  line-height: 1.35;
  color: var(--red);
}

.continuation-label {
  display: block;
  margin-top: -2px;
  font-size: 0.55em;
  line-height: 1;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.item-body p {
  margin: 0;
}

.item-body ul {
  margin: 10px 0 0 1.08em;
  padding: 0;
}

.item-body li {
  margin: 3px 0;
  padding-left: 0.22em;
}

.question-layout {
  display: grid;
  grid-template-columns: 68px minmax(0, 1fr);
  gap: 10px;
  align-items: start;
}

.question-number {
  padding-top: 4px;
  font-family: "Barlow Condensed", sans-serif;
  font-size: 38px;
  color: var(--red);
}

.question-text {
  margin: 0;
  font-family: "EB Garamond", serif;
  font-size: <%= type.fetch("question") %>px;
  font-weight: 600;
  line-height: 1.14;
}

.answer {
  margin: 38px 0 0 78px;
  padding-top: 28px;
  border-top: 2px solid rgba(201, 76, 59, 0.32);
  font-size: <%= type.fetch("answer") %>px;
  line-height: 1.36;
}

.answer-label {
  display: block;
  margin-bottom: 10px;
  font-family: "Barlow Condensed", sans-serif;
  font-size: 25px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--red);
}

.slide-footer {
  position: absolute;
  top: <%= layout.fetch("footer_y") %>px;
  left: var(--margin-x);
  right: var(--margin-x);
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-family: "Barlow Condensed", sans-serif;
  font-size: <%= type.fetch("footer") %>px;
  line-height: 1;
}

.course-footer {
  color: var(--red);
}

.global-pagination {
  color: var(--muted);
}

/* One persistent control group, centered between the two slide footer labels. */
.deck-navigation {
  position: absolute;
  top: <%= layout.fetch("footer_y") - 12 %>px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 8px;
  height: 44px;
  font-family: "Barlow Condensed", sans-serif;
  color: var(--muted);
}

.nav-icon, #section-select {
  height: 44px;
  border: 1px solid transparent;
  border-radius: 6px;
  background: var(--background);
  color: inherit;
  cursor: pointer;
}

.nav-icon {
  width: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px;
}

.nav-icon svg { width: 24px; height: 24px; }
.nav-icon:hover, .nav-icon[aria-expanded="true"], #section-select:hover {
  color: var(--red);
  background: #eee9e1;
}
.nav-icon:disabled { opacity: 0.35; cursor: default; }
.nav-icon:focus-visible, #section-select:focus-visible, .lesson-menu a:focus-visible {
  outline: 2px solid var(--red);
  outline-offset: 3px;
}
.nav-divider { height: 22px; border-left: 1px solid #d8d1c7; margin: 0 4px; }
#section-select { width: 230px; padding: 0 10px; font: 400 22px "Barlow Condensed", sans-serif; }

.lesson-menu {
  position: absolute;
  bottom: 58px;
  left: 50%;
  transform: translateX(-50%);
  width: 800px;
  padding: 20px;
  border: 1px solid #d8d1c7;
  border-radius: 10px;
  background: var(--background);
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.18);
}
.lesson-menu[hidden] { display: none; }
.lesson-menu h2 { margin: 0 10px 12px; font-size: 26px; font-weight: 600; color: var(--red); }
.lesson-menu ul { list-style: none; margin: 0; padding: 0 8px 0 0; max-height: 610px; overflow-y: scroll; overscroll-behavior: contain; scrollbar-color: #c8bfb4 transparent; scrollbar-width: thin; }
.lesson-menu a, .lesson-unavailable {
  display: grid;
  grid-template-columns: 34px 1fr;
  gap: 4px 12px;
  padding: 10px;
  border-radius: 5px;
  font-size: 24px;
  line-height: 1.2;
  text-decoration: none;
  color: var(--text);
}
.lesson-menu a:hover, .lesson-menu a:focus-visible { background: #eee9e1; }
.lesson-menu a[aria-current="page"] { background: #eee9e1; color: var(--red); font-weight: 600; }
.lesson-menu-number { color: var(--red); font-weight: 600; }
.lesson-unavailable, .lesson-unavailable .lesson-menu-number { color: var(--muted); }
.lesson-unavailable small { grid-column: 2; font-size: 18px; }

.cover-title {
  position: absolute;
  top: 252px;
  left: var(--margin-x);
  right: 250px;
  margin: 0;
  font-family: "EB Garamond", serif;
  font-size: <%= type.fetch("cover_title") %>px;
  font-weight: 700;
  line-height: 1.02;
  letter-spacing: -0.018em;
}

.cover-rule {
  position: absolute;
  left: var(--margin-x);
  top: 190px;
  width: 154px;
  height: 6px;
  background: var(--red);
}

.overflow-warning {
  outline: 8px solid #ff00cc;
  outline-offset: -8px;
}

.presenter-hint {
  position: fixed;
  right: 16px;
  bottom: 12px;
  z-index: 20;
  font-family: sans-serif;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.62);
  opacity: 0;
  transition: opacity 160ms ease;
}

body:hover .presenter-hint {
  opacity: 1;
}

@media print {
  @page {
    size: 16in 10in;
    margin: 0;
  }

  html,
  body {
    width: auto;
    height: auto;
    overflow: visible;
    background: #fff;
  }

  .deck-stage {
    position: static;
    width: auto;
    height: auto;
    transform: none !important;
    box-shadow: none;
  }

  .slide,
  .slide.is-active {
    position: relative;
    display: block;
    break-after: page;
    page-break-after: always;
  }

  .presenter-hint,
  .deck-navigation {
    display: none;
  }
}
