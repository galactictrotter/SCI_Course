@font-face {
  font-family: "Barlow Condensed";
  src: url("assets/fonts/barlow-condensed-400.ttf") format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: block;
}

@font-face {
  font-family: "Barlow Condensed";
  src: url("assets/fonts/barlow-condensed-600.ttf") format("truetype");
  font-weight: 600;
  font-style: normal;
  font-display: block;
}

@font-face {
  font-family: "EB Garamond";
  src: url("assets/fonts/eb-garamond-600.ttf") format("truetype");
  font-weight: 600;
  font-style: normal;
  font-display: block;
}

@font-face {
  font-family: "EB Garamond";
  src: url("assets/fonts/eb-garamond-700.ttf") format("truetype");
  font-weight: 700;
  font-style: normal;
  font-display: block;
}

@font-face {
  font-family: "Lora";
  src: url("assets/fonts/lora-400.ttf") format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: block;
}

@font-face {
  font-family: "Lora";
  src: url("assets/fonts/lora-600.ttf") format("truetype");
  font-weight: 600;
  font-style: normal;
  font-display: block;
}

:root {
  --canvas-width: <%= canvas_width %>px;
  --canvas-height: <%= canvas_height %>px;
  --background: <%= colors.fetch("background") %>;
  --text: <%= colors.fetch("text") %>;
  --red: <%= colors.fetch("red") %>;
  --muted: <%= colors.fetch("muted") %>;
  --stage: <%= colors.fetch("stage") %>;
  --margin-x: <%= layout.fetch("margin_x") %>px;
}

* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: var(--stage);
  color: var(--text);
}

body {
  font-family: "Lora", serif;
}

.deck-stage {
  position: absolute;
  left: 50%;
  top: 50%;
  width: var(--canvas-width);
  height: var(--canvas-height);
  transform-origin: center center;
  background: var(--background);
  box-shadow: 0 22px 70px rgba(0, 0, 0, 0.28);
}

.slide {
  position: absolute;
  inset: 0;
  display: none;
  width: var(--canvas-width);
  height: var(--canvas-height);
  padding: 0 var(--margin-x);
  overflow: hidden;
  background: var(--background);
}

.slide.is-active {
  display: block;
}

.slide-header {
  position: absolute;
  top: <%= layout.fetch("header_y") %>px;
  left: var(--margin-x);
  right: var(--margin-x);
  height: 44px;
  font-family: "Barlow Condensed", sans-serif;
  font-size: <%= type.fetch("section_header") %>px;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.02em;
  color: var(--red);
}

.lesson-title {
  position: absolute;
  top: <%= layout.fetch("content_y") %>px;
  left: var(--margin-x);
  right: var(--margin-x);
  margin: 0;
  font-family: "EB Garamond", serif;
  font-size: <%= type.fetch("lesson_title") %>px;
  font-weight: 600;
  line-height: 1.04;
  color: var(--text);
  height: 86px;
  overflow: hidden;
  white-space: normal;
}

.lesson-title--long {
  font-size: 39px;
  line-height: 1;
}

.slide-content {
  position: absolute;
  top: 242px;
  left: var(--margin-x);
  right: var(--margin-x);
  height: <%= layout.fetch("content_height") %>px;
  overflow: hidden;
  font-family: "Lora", serif;
  font-size: <%= type.fetch("body") %>px;
  font-weight: 400;
  line-height: 1.34;
}

.slide-content.compact {
  font-size: 27px;
  line-height: 1.31;
}

.numbered-item {
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr);
  gap: 4px;
  margin: 0 0 26px;
}

.numbered-item:last-child {
  margin-bottom: 0;
}

.item-number {
  font-family: "Barlow Condensed", sans-serif;
  font-size: 0.9em;
  line-height: 1.45;
  color: var(--red);
}

.continuation-label {
  display: block;
  margin-top: -2px;
  font-size: 0.55em;
  line-height: 1;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.item-body p {
  margin: 0;
}

.item-body ul {
  margin: 10px 0 0 1.08em;
  padding: 0;
}

.item-body li {
  margin: 3px 0;
  padding-left: 0.22em;
}

.question-layout {
  display: grid;
  grid-template-columns: 68px minmax(0, 1fr);
  gap: 10px;
  align-items: start;
}

.question-number {
  padding-top: 4px;
  font-family: "Barlow Condensed", sans-serif;
  font-size: 38px;
  color: var(--red);
}

.question-text {
  margin: 0;
  font-family: "EB Garamond", serif;
  font-size: <%= type.fetch("question") %>px;
  font-weight: 600;
  line-height: 1.14;
}

.answer {
  margin: 38px 0 0 78px;
  padding-top: 28px;
  border-top: 2px solid rgba(201, 76, 59, 0.32);
  font-size: <%= type.fetch("answer") %>px;
  line-height: 1.36;
}

.answer-label {
  display: block;
  margin-bottom: 10px;
  font-family: "Barlow Condensed", sans-serif;
  font-size: 25px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--red);
}

.slide-footer {
  position: absolute;
  top: <%= layout.fetch("footer_y") %>px;
  left: var(--margin-x);
  right: var(--margin-x);
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-family: "Barlow Condensed", sans-serif;
  font-size: <%= type.fetch("footer") %>px;
  line-height: 1;
}

.course-footer {
  color: var(--red);
}

.global-pagination {
  color: var(--muted);
}

.cover-title {
  position: absolute;
  top: 252px;
  left: var(--margin-x);
  right: 250px;
  margin: 0;
  font-family: "EB Garamond", serif;
  font-size: <%= type.fetch("cover_title") %>px;
  font-weight: 700;
  line-height: 1.02;
  letter-spacing: -0.018em;
}

.cover-rule {
  position: absolute;
  left: var(--margin-x);
  top: 190px;
  width: 154px;
  height: 6px;
  background: var(--red);
}

.overflow-warning {
  outline: 8px solid #ff00cc;
  outline-offset: -8px;
}

.presenter-hint {
  position: fixed;
  right: 16px;
  bottom: 12px;
  z-index: 20;
  font-family: sans-serif;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.62);
  opacity: 0;
  transition: opacity 160ms ease;
}

body:hover .presenter-hint {
  opacity: 1;
}

@media print {
  @page {
    size: 16in 10in;
    margin: 0;
  }

  html,
  body {
    width: auto;
    height: auto;
    overflow: visible;
    background: #fff;
  }

  .deck-stage {
    position: static;
    width: auto;
    height: auto;
    transform: none !important;
    box-shadow: none;
  }

  .slide,
  .slide.is-active {
    position: relative;
    display: block;
    break-after: page;
    page-break-after: always;
  }

  .presenter-hint {
    display: none;
  }
}
